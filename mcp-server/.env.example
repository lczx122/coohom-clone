# Coohom Open API credentials (B2B). Obtain these from Coohom after your
# business account is granted API access. Copy this file to .env for local
# testing, or set the same vars in your MCP client's server "env" block.

# Required — issued by Coohom for your application.
COOHOM_APP_KEY=
COOHOM_APP_SECRET=

# Optional — override if Coohom gives you a region-specific host.
# COOHOM_BASE_URL=https://www.coohom.com

# Optional — signing formula variant. See src/sign.ts. One of:
#   md5-concat         (default)  sign = MD5(appSecret + appKey + timestamp)
#   md5-sorted-params            sign includes sorted business params
# Confirm which your account's docs specify.
# COOHOM_SIGN_SCHEME=md5-concat

# Optional — per-request timeout in ms.
# COOHOM_TIMEOUT_MS=30000
