{
  "name": "coohom-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that wraps the Coohom Open API (projects, rendering, bill-of-materials) so an MCP client (e.g. Claude) can drive Coohom design projects.",
  "bin": {
    "coohom-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.2"
  }
}
